\newcommand{\SlideHtwo}[1]{{\SlideLatinBoldFace\fontsize{24.375bp}{29bp}\selectfont\color{SlideText}#1}}
\newcommand{\SlideHthree}[1]{{\SlideTitleFont\fontsize{19.5bp}{24bp}\selectfont\color{SlideAccent}#1}}
