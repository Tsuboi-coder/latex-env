\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{marp-beamer-design}[2026/09/05 High-fidelity Marp-to-Beamer reproduction]

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{marp-beamer-design}{Compile with LuaLaTeX}{This theme uses luatexja-fontspec.}
\fi
\RequirePackage{luatexja-fontspec}
\RequirePackage{fontspec}
\RequirePackage{tikz}
\usetikzlibrary{calc,shadings}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{amssymb}

% -----------------------------------------------------------------------------
% Geometry
% Marp renders 1280 x 720 CSS px to a 960 x 540 bp PDF (0.75 bp / CSS px).
% The previous version kept Beamer's default 453.5 x 255.1 bp canvas while
% using Marp-sized font points.  That made every text element about 2.12x too
% large relative to the page.  Here the PDF canvas itself is made identical.
% -----------------------------------------------------------------------------
\makeatletter
\setlength{\beamer@paperwidth}{960bp}
\setlength{\beamer@paperheight}{540bp}
\makeatother
\geometry{papersize={960bp,540bp},margin=0bp}
\setlength{\paperwidth}{960bp}
\setlength{\paperheight}{540bp}
\setlength{\textwidth}{960bp}
\setlength{\textheight}{540bp}
\setlength{\hoffset}{0bp}
\setlength{\voffset}{0bp}
\setbeamersize{text margin left=0bp,text margin right=0bp}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{frametitle}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{headline}{}

% -----------------------------------------------------------------------------
% Fonts
% The source Marp PDF embeds:
%   headings  : HiraKakuProN-W6
%   body JP   : HiraMaruProN-W4
%   body Latin: Helvetica
%   code      : Menlo-Regular
% On macOS those exact fonts are selected.  Linux fallbacks are only for preview.
% Scale=1 is deliberate: luatexja otherwise scales CJK glyphs relative to Latin.
% -----------------------------------------------------------------------------
\IfFontExistsTF{Helvetica}{
  \newfontfamily\SlideBodyLatinFont{Helvetica}[Scale=1]
  \newfontfamily\SlideBodyLatinBoldFont{Helvetica}[Scale=1,BoldFont=Helvetica Bold]
}{
  \IfFontExistsTF{Nimbus Sans}{
    \newfontfamily\SlideBodyLatinFont{Nimbus Sans}[Scale=1]
    \newfontfamily\SlideBodyLatinBoldFont{Nimbus Sans}[Scale=1,BoldFont=Nimbus Sans Bold]
  }{
    \newfontfamily\SlideBodyLatinFont{TeX Gyre Heros}[Scale=1]
    \newfontfamily\SlideBodyLatinBoldFont{TeX Gyre Heros}[Scale=1,BoldFont=TeX Gyre Heros Bold]
  }
}

\IfFontExistsTF{HiraMaruProN-W4}{
  \IfFontExistsTF{HiraKakuProN-W6}{
    \newjfontfamily\SlideBodyJPFont{HiraMaruProN-W4}[Scale=1,BoldFont={HiraKakuProN-W6}]
  }{
    \newjfontfamily\SlideBodyJPFont{HiraMaruProN-W4}[Scale=1]
  }
}{
  \IfFontExistsTF{Hiragino Maru Gothic ProN W4}{
    \newjfontfamily\SlideBodyJPFont{Hiragino Maru Gothic ProN W4}[Scale=1]
  }{
    \newjfontfamily\SlideBodyJPFont{Noto Sans CJK JP}[Scale=1]
  }
}

\IfFontExistsTF{HiraKakuProN-W6}{
  \newfontfamily\SlideTitleLatinFont{HiraKakuProN-W6}[Scale=1]
  \newjfontfamily\SlideTitleJPFont{HiraKakuProN-W6}[Scale=1]
}{
  \IfFontExistsTF{Hiragino Kaku Gothic ProN W6}{
    \newfontfamily\SlideTitleLatinFont{Hiragino Kaku Gothic ProN W6}[Scale=1]
    \newjfontfamily\SlideTitleJPFont{Hiragino Kaku Gothic ProN W6}[Scale=1]
  }{
    \newfontfamily\SlideTitleLatinFont{Noto Sans CJK JP}[Scale=1]
    \newjfontfamily\SlideTitleJPFont{Noto Sans CJK JP}[Scale=1]
  }
}

\IfFontExistsTF{Menlo}{
  \newfontfamily\SlideCodeFont{Menlo}[Scale=1]
}{
  \newfontfamily\SlideCodeFont{DejaVu Sans Mono}[Scale=1]
}

\newcommand{\SlideBodyFace}{\SlideBodyLatinFont\SlideBodyJPFont}
\newcommand{\SlideTitleFont}{\SlideTitleLatinFont\SlideTitleJPFont\bfseries}
\newcommand{\SlideLatinBoldFace}{\SlideBodyLatinFont\bfseries}

