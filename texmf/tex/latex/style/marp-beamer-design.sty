% -----------------------------------------------------------------------------
% Absolute PDF-coordinate helpers
% Coordinates are in PDF points from the top-left, exactly like the source PDF.
% -----------------------------------------------------------------------------
\newcommand{\SlideNodeBase}[4]{% x, target PDF baseline-y, options, text
  \pgfmathsetmacro{\SlideNodeY}{#2}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=base west,inner sep=0bp,outer sep=0bp,#3]
      at ([xshift=#1bp,yshift=-\SlideNodeY bp]current page.north west) {#4};
  \end{tikzpicture}%
}
\newcommand{\SlideNodeBaseEast}[4]{% x, target PDF baseline-y, options, text
  \pgfmathsetmacro{\SlideNodeY}{#2}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=base east,inner sep=0bp,outer sep=0bp,#3]
      at ([xshift=#1bp,yshift=-\SlideNodeY bp]current page.north west) {#4};
  \end{tikzpicture}%
}
\newcommand{\SlideNodeBaseCenter}[4]{% x, target PDF baseline-y, options, text
  \pgfmathsetmacro{\SlideNodeY}{#2}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=base,inner sep=0bp,outer sep=0bp,#3]
      at ([xshift=#1bp,yshift=-\SlideNodeY bp]current page.north west) {#4};
  \end{tikzpicture}%
}
\newcommand{\SlideRectTop}[6]{% x,y,w,h,draw/fill opts,radius
  \begin{tikzpicture}[remember picture,overlay]
    \path[#5,rounded corners=#6bp]
      ([xshift=#1bp,yshift=-#2bp]current page.north west)
      rectangle ++(#3bp,-#4bp);
  \end{tikzpicture}%
}

% Reusable exact-position content helpers.
\newcommand{\SlideTextAt}[4]{% x, baseline-y, size, text
  \SlideNodeBase{#1}{#2}{}{\SlideBodyFace\fontsize{#3bp}{#3bp}\selectfont\color{SlideText}#4}}
\newcommand{\SlideMutedAt}[4]{\SlideNodeBase{#1}{#2}{}{\SlideBodyFace\fontsize{#3bp}{#3bp}\selectfont\color{SlideMuted}#4}}
\newcommand{\SlideTitleAt}[4]{\SlideNodeBase{#1}{#2}{}{\SlideTitleFont\fontsize{#3bp}{#3bp}\selectfont\color{SlideDark}#4}}
\newcommand{\SlideLatinBoldAt}[4]{\SlideNodeBase{#1}{#2}{}{\SlideLatinBoldFace\fontsize{#3bp}{#3bp}\selectfont\color{SlideText}#4}}

% Page number: source PDF right edge = 912 bp, baseline = 514.5 bp.
\newcommand{\SlidePageNumber}{%
  \SlideNodeBaseEast{912}{514.5}{}{\SlideLatinBoldFace\fontsize{18.75bp}{18.75bp}\selectfont\color{SlideDark}\insertframenumber}}

% -----------------------------------------------------------------------------
% Base-design backgrounds calibrated from the rendered Marp PDF, not CSS alone.
% -----------------------------------------------------------------------------
\newcommand{\BaseNormalBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[white] (current page.south west) rectangle (current page.north east);
    % PDF: y=61..63, x=48..255 accent, x=257..911 line.
    \fill[SlideAccent] ([xshift=48bp,yshift=-61bp]current page.north west) rectangle ++(208bp,-3bp);
    \fill[SlideLine] ([xshift=256bp,yshift=-61bp]current page.north west) rectangle ++(656bp,-3bp);
  \end{tikzpicture}%
}
\newcommand{\BaseTitleBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    % underlying 135-degree white -> light gradient
    \shade[shading angle=-45,left color=white,right color=SlideLight]
      (current page.south west) rectangle (current page.north east);
    % hard overlay edge measured from PDF: (867,0) -> (692,540)
    \fill[SlideAccent,opacity=.14]
      ([xshift=867bp]current page.north west) --
      (current page.north east) -- (current page.south east) --
      ([xshift=692bp]current page.south west) -- cycle;
    % PDF left bar = 15 bp.
    \fill[SlideAccent] (current page.south west) rectangle ([xshift=15bp]current page.north west);
  \end{tikzpicture}%
}
\newcommand{\BaseTocBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \shade[shading angle=-45,left color=white,right color=SlideLight]
      (current page.south west) rectangle (current page.north east);
    \fill[SlideAccent,opacity=.14]
      ([xshift=867bp]current page.north west) --
      (current page.north east) -- (current page.south east) --
      ([xshift=692bp]current page.south west) -- cycle;
  \end{tikzpicture}%
}
\newcommand{\BaseSectionBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[white] (current page.south west) rectangle (current page.north east);
    % PDF boundary: top x=300 bp, bottom x=144 bp.
    \fill[SlideSectionPale]
      (current page.north west) -- ([xshift=300bp]current page.north west) --
      ([xshift=144bp]current page.south west) -- (current page.south west) -- cycle;
  \end{tikzpicture}%
}
\newcommand{\BaseStatementBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    % CSS radial-gradient centre = 50% 45%.  Fill the full page with the
    % outer colour first, then lay the radial shade on top so that corners
    % cannot fall back to white.
    \fill[SlideAccent!28!white] (current page.south west) rectangle (current page.north east);
    \shade[inner color=SlideLight,outer color=SlideAccent!28!white]
      ([yshift=27bp]current page.center) circle[radius=610bp];
  \end{tikzpicture}%
}
\newcommand{\BaseSummaryBackground}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[SummaryBg] (current page.south west) rectangle (current page.north east);
  \end{tikzpicture}%
}

% Minimal compatibility backgrounds for the other design selectors.
\newcommand{\FormalNormalBackground}{\BaseNormalBackground}
\newcommand{\FormalTitleBackground}{\BaseTitleBackground}
\newcommand{\FormalSectionBackground}{\BaseSectionBackground}
\newcommand{\FormalStatementBackground}{\BaseStatementBackground}
\newcommand{\FormalSummaryBackground}{\BaseSummaryBackground}
\newcommand{\YnuNormalBackground}{\BaseNormalBackground}
\newcommand{\YnuTitleBackground}{\BaseTitleBackground}
\newcommand{\YnuSectionBackground}{\BaseSectionBackground}

% -----------------------------------------------------------------------------
% Frame constructors (same macro names as the first version)
% -----------------------------------------------------------------------------
\NewDocumentCommand{\TitleFrame}{m m m}{%
  \begin{frame}[plain]
    \BaseTitleBackground
    % positions/sizes read directly from source PDF spans
    \SlideNodeBase{93}{207.75}{}{\SlideTitleFont\fontsize{43.5bp}{43.5bp}\selectfont\color{SlideDark}#1}
    \SlideNodeBase{93}{267.75}{}{\SlideBodyFace\fontsize{23.25bp}{23.25bp}\selectfont\color{SlideText}#2}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[SlideAccent,rounded corners=1.5bp]
        ([xshift=93bp,yshift=-294.75bp]current page.north west) rectangle ++(90bp,-3bp);
    \end{tikzpicture}
    \SlideNodeBase{93}{368.25}{}{\SlideBodyFace\fontsize{17.25bp}{17.25bp}\selectfont\color{SlideMuted}#3}
  \end{frame}%
}

\NewDocumentCommand{\TOCFrame}{m}{%
  \begin{frame}[plain]
    \BaseTocBackground
    \SlideNodeBase{48}{48}{}{\SlideTitleFont\fontsize{25.5bp}{25.5bp}\selectfont\color{SlideDark}目次}
    #1
    \SlidePageNumber
  \end{frame}%
}
\newcommand{\TOCItem}[3]{% index, baseline-y, text
  \SlideNodeBase{51}{#2}{}{\SlideLatinBoldFace\fontsize{19.5bp}{19.5bp}\selectfont\color{SlideAccent}#1}
  \SlideNodeBase{103.5}{#2}{}{\SlideBodyFace\fontsize{21.75bp}{21.75bp}\selectfont\color{SlideText}#3}
  \pgfmathsetmacro{\tocliney}{#2+31.5}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[SlideLine]
      ([xshift=48bp,yshift=-\tocliney bp]current page.north west) rectangle ++(708.75bp,-0.75bp);
  \end{tikzpicture}%
}

\NewDocumentCommand{\SectionFrame}{m m m}{%
  \begin{frame}[plain]
    \BaseSectionBackground
    \SlideNodeBase{300}{209.25}{}{\SlideLatinBoldFace\fontsize{22.5bp}{22.5bp}\selectfont\color{SlideAccent}#1}
    \SlideNodeBase{300}{277.5}{}{\SlideTitleFont\fontsize{42bp}{42bp}\selectfont\color{SlideDark}#2}
    \SlideNodeBase{300}{342}{}{\SlideBodyFace\fontsize{18bp}{18bp}\selectfont\color{SlideMuted}#3}
    \SlidePageNumber
  \end{frame}%
}

\NewDocumentCommand{\NormalFrame}{m +m}{%
  \begin{frame}[plain]
    \BaseNormalBackground
    \SlideNodeBase{48}{48}{}{\SlideTitleFont\fontsize{25.5bp}{25.5bp}\selectfont\color{SlideDark}#1}
    #2
    \SlidePageNumber
  \end{frame}%
}

\newcommand{\StatementLine}[2]{% baseline-y, text
  \SlideNodeBaseCenter{480}{#1}{}{% 
    \SlideTitleFont\fontsize{37.5bp}{37.5bp}\selectfont\color{SlideDark}#2}%
}
\NewDocumentCommand{\StatementFrame}{m m}{%
  \begin{frame}[plain]
    \BaseStatementBackground
    % #1 is intentionally a set of \StatementLine calls.  This avoids
    % TeX line-box metrics from shifting the two baselines relative to Marp.
    #1
    \SlideNodeBaseCenter{480}{348.75}{}{% 
      \SlideBodyFace\fontsize{17.25bp}{17.25bp}\selectfont\color{SlideMuted}#2}
  \end{frame}%
}
\newcommand{\SummaryItem}[2]{% top-y, text
  \pgfmathsetmacro{\summaryTextY}{#1+33.75}
  \pgfmathsetmacro{\summaryCheckY}{#1+32.25}
  \pgfmathsetmacro{\summaryLineTop}{#1+6}
  \pgfmathsetmacro{\summaryLineBottom}{#1+49.5}
  \begin{tikzpicture}[remember picture,overlay]
    \path[fill=white,draw=SlideLine,line width=.75bp,rounded corners=6bp]
      ([xshift=48bp,yshift=-#1bp]current page.north west) rectangle ++(864bp,-55.5bp);
    \draw[SlideAccent,line width=3.75bp]
      ([xshift=49.875bp,yshift=-\summaryLineTop bp]current page.north west) --
      ([xshift=49.875bp,yshift=-\summaryLineBottom bp]current page.north west);
  \end{tikzpicture}
  \SlideNodeBase{69}{\summaryCheckY}{}{\SlideBodyJPFont\fontsize{18.75bp}{18.75bp}\selectfont\color{SlideAccent}✓}
  \SlideNodeBase{98.25}{\summaryTextY}{}{\SlideBodyFace\fontsize{18.75bp}{18.75bp}\selectfont\color{SlideText}#2}
}
\NewDocumentCommand{\SummaryFrame}{m +m}{%
  \begin{frame}[plain]
    \BaseSummaryBackground
    \SlideNodeBase{48}{48}{}{\SlideTitleFont\fontsize{25.5bp}{25.5bp}\selectfont\color{SlideDark}#1}
    #2
    \SlidePageNumber
  \end{frame}%
}

% -----------------------------------------------------------------------------
% Common content helpers; names retained from the first version.
% -----------------------------------------------------------------------------
\newcommand{\SlideBulletAt}[2]{% baseline-y, text
  \pgfmathsetmacro{\SlideBulletY}{#1-5.5}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[SlideText] ([xshift=71.5bp,yshift=-\SlideBulletY bp]current page.north west) circle[radius=2.45bp];
  \end{tikzpicture}
  \SlideNodeBase{85.5}{#1}{}{\SlideBodyFace\fontsize{18.75bp}{18.75bp}\selectfont\color{SlideText}#2}%
}
\newcommand{\SlideQuoteAt}[2]{% baseline-y, text
  \pgfmathsetmacro{\SlideQuoteTop}{#1-20.75}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[QuoteBar]
      ([xshift=48bp,yshift=-\SlideQuoteTop bp]current page.north west) rectangle ++(4bp,-28bp);
  \end{tikzpicture}
  \SlideNodeBase{71.25}{#1}{}{\SlideBodyFace\fontsize{18.75bp}{18.75bp}\selectfont\color{SlideMuted}#2}%
}
\newcommand{\SlideHtwoAt}[2]{% baseline-y,text
  \SlideNodeBase{48}{#1}{}{\SlideLatinBoldFace\fontsize{24.375bp}{24.375bp}\selectfont\color{SlideText}#2}%
}
\newcommand{\SlideCodeAt}[2]{% baseline-y,text
  \SlideNodeBase{54.375}{#1}{}{\SlideCodeFont\fontsize{15.9375bp}{15.9375bp}\selectfont\color{SlideText}#2}%
}

