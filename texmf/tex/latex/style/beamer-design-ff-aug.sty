% complex version(複雑)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamer-design-ff-aug}[2026/09/13 Configurable Frankfurt-based Beamer design]

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{beamer-design-ff-aug}
    {Compile with LuaLaTeX}
    {This package uses luatexja-fontspec.}%
\fi

\RequirePackage{luatexja-fontspec}
\RequirePackage{etoolbox}

% Load Frankfurt before applying this package's customizations so that the
% theme cannot overwrite them later.
\usetheme{Frankfurt}

% -----------------------------------------------------------------------------
% Fonts
% -----------------------------------------------------------------------------
% Keep this preset self-contained: loading hiragino-slides as well is neither
% necessary nor supported.  The directory is mounted by scripts/latexmk-docker.
\providecommand{\HiraginoFontPath}{/host-fonts/system/}

% Body Japanese.  It deliberately occupies the Japanese roman family: Beamer
% uses a sans family for Latin body text, while Japanese body text must remain
% HiraMaru rather than following it to the Japanese sans family.
\setmainjfont[
  Path = \HiraginoFontPath,
  BoldFont = {ヒラギノ角ゴシック W6.ttc}
]{ヒラギノ丸ゴ ProN W4.ttc}

% Japanese headings and explicit \textsf{...}.
\setsansjfont[
  Path = \HiraginoFontPath
]{ヒラギノ角ゴシック W6.ttc}

% Latin body, headings, and explicit \textsf{...}.
\setsansfont[
  Path = \HiraginoFontPath,
  BoldFont = {HelveticaNeue.ttc},
  BoldFeatures = {FontIndex=1}
]{HelveticaNeue.ttc}

% Use a dedicated family for Latin text inside \textsf.  Selecting the TTC
% face directly avoids losing the bold series when Latin and Japanese family
% switches occur together in mixed-language text.
\newfontfamily\FFAugTextsfLatin[
  Path = \HiraginoFontPath,
  FontIndex = 1
]{HelveticaNeue.ttc}

\newfontfamily\FFAugBodyLatin[
  Path = \HiraginoFontPath,
  FontIndex = 0
]{HelveticaNeue.ttc}

% Paired family used wherever this preset selects HiraKaku W6: Japanese is
% HiraKaku W6 and Latin is Helvetica Neue Bold.
\newcommand{\FFAugGothicFamily}{\gtfamily\FFAugTextsfLatin}
\newcommand{\FFAugBodyFamily}{\mcfamily\FFAugBodyLatin}

\renewcommand{\familydefault}{\sfdefault}
\renewcommand{\kanjifamilydefault}{\mcdefault}

% LuaTeX-ja manages Latin and Japanese families independently.  LaTeX's
% standard \textsf changes only the Latin family, so explicitly select the
% Japanese gothic family as well.
\DeclareTextFontCommand{\textsf}{\FFAugGothicFamily}

% Beamer: use serif fonts only for mathematics.
\usefonttheme[onlymath]{serif}

% Select the Latin and Japanese heading families independently.  In
% particular, \sffamily alone does not reliably change LuaTeX-ja's family when
% another font preset has been loaded before this package.
\newcommand{\FFAugHeadingFamily}{\FFAugGothicFamily\mdseries\upshape}

\setbeamerfont{title}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{subtitle}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{frametitle}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{framesubtitle}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{section title}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{section in head/foot}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{subsection in head/foot}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{block title}{family=\FFAugHeadingFamily,series=\mdseries}

% Compact list indentation (Beamer's defaults are 2em at every level).
\setlength{\leftmargini}{1.2em}
\setlength{\leftmarginii}{1.2em}
\setlength{\leftmarginiii}{1.2em}

% Compact replacement for Beamer's frame-number footline.  Keep only a small
% gap above the number and avoid the default strut and bottom padding.
\setbeamerfont{page number in head/foot}{size=\tiny,series=\mdseries}
\defbeamertemplate{footline}{ff aug frame number}{%
  \vskip0.25pt%
  \hbox to\paperwidth{%
    \hfill%
    \usebeamercolor[fg]{page number in head/foot}%
    \usebeamerfont{page number in head/foot}%
    \usebeamertemplate*{page number in head/foot}%
    \kern1em%
  }%
  \vskip2pt%
}[action]{%
  \setbeamertemplate{page number in head/foot}[totalframenumber]%
}
\defbeamertemplatealias{footline}{frame number}{ff aug frame number}

\endinput
