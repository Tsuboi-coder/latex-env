% complex version(複雑)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamer-design-ff-aug-complex}[2026/09/13 Configurable Frankfurt-based Beamer design]

\RequirePackage{iftex}
\ifLuaTeX\else
  \PackageError{beamer-design-ff-aug-complex}
    {Compile with LuaLaTeX}
    {This package uses luatexja-fontspec.}%
\fi

\RequirePackage{luatexja-fontspec}
\RequirePackage{etoolbox}

% Load Frankfurt before applying this package's customizations so that the
% theme cannot overwrite them later.
\usetheme{Frankfurt}

% -----------------------------------------------------------------------------
% Heading fonts
% -----------------------------------------------------------------------------
\providecommand{\HiraginoFontPath}{/host-fonts/system/}

\newfontfamily\FFAugHeadingLatin[
  Path = \HiraginoFontPath
]{HelveticaNeue.ttc}

\newjfontfamily\FFAugHeadingJapanese[
  Path = \HiraginoFontPath
]{ヒラギノ角ゴシック W6.ttc}

\newcommand{\FFAugHeadingFamily}{%
  \FFAugHeadingLatin\FFAugHeadingJapanese\mdseries\upshape
}

\setbeamerfont{title}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{subtitle}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{frametitle}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{framesubtitle}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{section title}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{section in head/foot}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{subsection in head/foot}{family=\FFAugHeadingFamily,series=\mdseries}
\setbeamerfont{block title}{family=\FFAugHeadingFamily,series=\mdseries}

% Give Frankfurt's frame titles and section navigation the same inset on both
% sides.  The stock theme uses only 0.3 cm for frame titles and no outer inset
% for the section navigation.
% Keep this as an expandable dimension rather than a length register: the
% beamercolorbox skip parser must be able to continue reading "plus 1fil".
\newcommand{\FFAugHeadingMargin}{0.7cm}
\makeatletter
\expandafter\patchcmd\csname beamer@@tmpl@frametitle\endcsname
  {leftskip=.3cm,rightskip=.3cm plus1fil}
  {leftskip=\FFAugHeadingMargin,rightskip=\FFAugHeadingMargin plus1fil}
  {}{\PackageWarning{beamer-design-ff-aug}{Could not patch the Frankfurt frame-title margins}}
% Frankfurt reserves 0.5 ex above the title but only 0.05 ex below it.  With
% Hiragino Kaku Gothic this makes the visible glyphs look slightly low.  Keep
% the combined 0.55 ex unchanged while moving 0.2 ex from above to below.
\expandafter\patchcmd\csname beamer@@tmpl@frametitle\endcsname
  {\vskip0.5ex}
  {\vskip0.3ex}
  {}{\PackageWarning{beamer-design-ff-aug}{Could not adjust the frame-title top spacing}}
\expandafter\patchcmd\csname beamer@@tmpl@frametitle\endcsname
  {\vskip0.05ex}
  {\vskip0.25ex}
  {}{\PackageWarning{beamer-design-ff-aug}{Could not adjust the frame-title bottom spacing}}
% \insertnavigation already contains 0.3 cm skips at both ends.  Replace those
% directly so that its text begins at exactly the same x position as a frame
% title; adding an outer skip here would double the left margin.
\patchcmd{\insertnavigation}
  {\hskip.3cm}
  {\hskip\FFAugHeadingMargin}
  {}{\PackageWarning{beamer-design-ff-aug}{Could not patch the left section-navigation margin}}
\patchcmd{\insertnavigation}
  {\hskip.3cm}
  {\hskip\FFAugHeadingMargin}
  {}{\PackageWarning{beamer-design-ff-aug}{Could not patch the right section-navigation margin}}
\expandafter\patchcmd\csname beamer@@tmpl@headline\endcsname
  {leftskip=.3cm,rightskip=.3cm plus1fil}
  {leftskip=\FFAugHeadingMargin,rightskip=\FFAugHeadingMargin plus1fil}
  {}{\PackageWarning{beamer-design-ff-aug}{Could not patch the Frankfurt subsection margins}}
\makeatother

% -----------------------------------------------------------------------------
% Color palettes
% -----------------------------------------------------------------------------
\newcommand{\SlideColorName}{green}
\newcommand{\SetSlideColor}[1]{%
  \renewcommand{\SlideColorName}{#1}%
  \FFAugApplyPalette
}

\newcommand{\FFAugApplyPalette}{%
  % Green is also the fallback for an unknown palette name.
  \definecolor{FFAugAccent}{HTML}{20B75D}%
  \definecolor{FFAugDark}{HTML}{087A3D}%
  \definecolor{FFAugLight}{HTML}{EEFBF3}%
  \ifdefstring{\SlideColorName}{blue}{%
    \definecolor{FFAugAccent}{HTML}{3B82C4}%
    \definecolor{FFAugDark}{HTML}{245B91}%
    \definecolor{FFAugLight}{HTML}{EEF6FC}%
  }{}%
  \ifdefstring{\SlideColorName}{red}{%
    \definecolor{FFAugAccent}{HTML}{D05252}%
    \definecolor{FFAugDark}{HTML}{923333}%
    \definecolor{FFAugLight}{HTML}{FDF0F0}%
  }{}%
  \ifdefstring{\SlideColorName}{orange}{%
    \definecolor{FFAugAccent}{HTML}{DF7A2C}%
    \definecolor{FFAugDark}{HTML}{9A4E17}%
    \definecolor{FFAugLight}{HTML}{FFF4EB}%
  }{}%
  \ifdefstring{\SlideColorName}{purple}{%
    \definecolor{FFAugAccent}{HTML}{8A65B8}%
    \definecolor{FFAugDark}{HTML}{5C3D86}%
    \definecolor{FFAugLight}{HTML}{F5F0FA}%
  }{}%
  \ifdefstring{\SlideColorName}{peach}{%
    \definecolor{FFAugAccent}{HTML}{E28A73}%
    \definecolor{FFAugDark}{HTML}{A45542}%
    \definecolor{FFAugLight}{HTML}{FFF3EF}%
  }{}%
  \setbeamercolor{structure}{fg=FFAugDark}%
  \setbeamercolor{palette primary}{fg=white,bg=FFAugDark}%
  \setbeamercolor{palette secondary}{fg=white,bg=FFAugAccent}%
  \setbeamercolor{palette tertiary}{fg=white,bg=FFAugDark}%
  % Frankfurt uses the quaternary palette for the section-navigation bar.
  % Keep that bar black, independently of the selected accent color.
  \setbeamercolor{palette quaternary}{fg=white,bg=black}%
  % Frankfurt's rounded title box inherits titlelike; both foreground and
  % background must therefore be set explicitly.
  \setbeamercolor{titlelike}{fg=white,bg=FFAugDark}%
  \setbeamercolor{title}{fg=white,bg=FFAugDark}%
  \setbeamercolor{frametitle}{fg=white,bg=FFAugDark}%
  \setbeamercolor{block title}{fg=white,bg=FFAugDark}%
  \setbeamercolor{block body}{fg=black,bg=FFAugLight}%
  \setbeamercolor{item projected}{fg=white,bg=FFAugAccent}%
  \setbeamercolor{page number in head/foot}{fg=black,bg=white}%
}
\FFAugApplyPalette

% -----------------------------------------------------------------------------
% Footer
% -----------------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamerfont{page number in head/foot}{size=\footnotesize,series=\mdseries}
\setbeamertemplate{footline}{%
  \leavevmode
  \hbox{%
    \begin{beamercolorbox}[
      wd=\paperwidth,
      ht=2.5ex,
      dp=2.5ex,
      rightskip=2.5em
    ]{page number in head/foot}%
      \usebeamerfont{page number in head/foot}%
      \hfill\insertframenumber
    \end{beamercolorbox}%
  }%
}

\endinput
