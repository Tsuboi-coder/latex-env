\renewcommand{\lstlistingname}{Code}

\captionsetup[lstlisting]{
  format=plain,
  justification=raggedright,
  singlelinecheck=false,
  font=normalsize,
  labelfont={normalsize,bf},
  textfont={normalsize,bf},
  labelsep=colon,
  skip=5pt
}
\captionsetup[algorithm]{
  format=plain,
  justification=raggedright,
  singlelinecheck=false,
  font=normalsize,
  labelfont={normalsize,bf},
  textfont={normalsize,normalfont},
  labelsep=colon,
  skip=5pt
}

\lstdefinelanguage{mypython}{
  sensitive=true,
  morekeywords=[1]{
    and,as,assert,async,await,
    break,class,continue,def,del,
    elif,else,except,False,finally,
    for,from,global,if,import,in,
    is,lambda,None,nonlocal,not,
    or,pass,raise,return,True,
    try,while,with,yield
  },
  morekeywords=[2]{
    print,len,range,input,
    str,int,float,list,dict,set,tuple,
    open,type,isinstance,
    enumerate,zip,map,filter,
    sum,min,max,abs,round,
    all,any,sorted,reversed
  },
  morekeywords=[3]{f,fr,rf},
  keywordstyle=[1]\color{blue}\bfseries,
  keywordstyle=[2]\color{teal},
  keywordstyle=[3]\color{red!50!black},
  morecomment=[l]\#,
  commentstyle=\color{green!50!black},
  morestring=[b]",
  morestring=[b]',
  stringstyle=\ttfamily\color{red!70!black},
  basicstyle=\ttfamily\small,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  showstringspaces=false
}

\lstset{
  language=mypython,
  basicstyle=\ttfamily\small,
  keywordstyle=\color{blue}\bfseries,
  commentstyle=\color{green!50!black},
  stringstyle=\ttfamily\color{red!50!black},
  numbers=left,
  numberstyle=\ttfamily\footnotesize\color{gray},
  stepnumber=1,
  numbersep=10pt,
  backgroundcolor=\color{white},
  showstringspaces=false,
  breaklines=true,
  breakindent=15pt,
  frame=tb,
  float=false,
  rulecolor=\color{black},
  xleftmargin=25pt,
  framexleftmargin=25pt,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  aboveskip=7.5pt,
  captionpos=t,
  breakatwhitespace=true
}

\lstnewenvironment{code}[1][]
{%
  \lstset{
    language=mypython,
    basicstyle=\ttfamily\small,
    keywordstyle=\color{blue}\bfseries,
    commentstyle=\color{green!50!black},
    stringstyle=\ttfamily\color{red!50!black},
    numbers=left,
    numberstyle=\ttfamily\footnotesize\color{gray},
    stepnumber=1,
    numbersep=10pt,
    frame=none,
    float=false,
    xleftmargin=25pt,
    framexleftmargin=25pt,
    columns=fullflexible,
    keepspaces=true,
    upquote=true,
    breaklines=true,
    breakindent=15pt,
    aboveskip=0pt,
    belowskip=0pt,
    showstringspaces=false,
    captionpos=t,
    breakatwhitespace=true,
    #1
  }%
}
{}

\lstnewenvironment{codeoutput}[1][]
{%
  \lstset{
    language={},
    numbers=none,
    frame=none,
    backgroundcolor=\color{gray!10},
    basicstyle=\ttfamily\fontsize{9}{14}\selectfont,
    xleftmargin=20pt,
    framexleftmargin=20pt,
    columns=flexible,
    framesep=0pt,
    keepspaces=true,
    breaklines=true,
    breakindent=15pt,
    upquote=true,
    breakatwhitespace=true,
    #1
  }%
}
{}

