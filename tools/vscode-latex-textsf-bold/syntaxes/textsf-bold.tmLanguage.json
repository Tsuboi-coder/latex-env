{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LaTeX textsf Bold",
  "scopeName": "text.tex.latex.textsf-bold",
  "injectionSelector": "L:text.tex.latex",
  "patterns": [
    {
      "begin": "((\\\\)textsf)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "support.function.textsf.latex"
        },
        "2": {
          "name": "punctuation.definition.function.latex"
        },
        "3": {
          "name": "punctuation.definition.textsf.begin.latex"
        }
      },
      "contentName": "markup.bold.textsf.latex",
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.textsf.end.latex"
        }
      },
      "name": "meta.function.textsf.latex",
      "patterns": [
        {
          "include": "text.tex#braces"
        },
        {
          "include": "text.tex.latex"
        }
      ]
    }
  ]
}
