#!/usr/bin/env bash

set -euo pipefail

LATEX_IMAGE="${LATEX_IMAGE:-latex-env:2026}"

DOCKER_ARGS=(
    --rm
    -v "$(pwd):/work"
    -w /work
)

# 独自スタイルは任意。指定された TEXMF ツリーだけを読み取り専用で共有する。
if [[ -n "${LATEX_STYLES_ROOT:-}" ]]; then
    if [[ ! -d "$LATEX_STYLES_ROOT" ]]; then
        echo "latexmk-docker: LATEX_STYLES_ROOT is not a directory: $LATEX_STYLES_ROOT" >&2
        exit 2
    fi
    DOCKER_ARGS+=(
        -v "$LATEX_STYLES_ROOT:/root/texmf:ro"
    )
fi

# macOS のシステムフォントは、実在するホストでだけ共有する。
# Linux / WSL ではこのマウントを省き、TeX Live 収録フォントを使用する。
if [ -d "/System/Library/Fonts" ]; then
    DOCKER_ARGS+=(
        -v "/System/Library/Fonts:/host-fonts/system:ro"
    )
fi

docker run "${DOCKER_ARGS[@]}" \
    "$LATEX_IMAGE" \
    latexmk "$@"
